// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the driver adapter (src/db.ts), not here.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model User {
  id           String   @id @default(uuid())
  /// Stored lower-cased and trimmed.
  email        String   @unique
  name         String?
  /// scrypt hash, never the password itself.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]
  diagrams Diagram[]

  @@map("erd_users")
}

model Session {
  id String @id @default(uuid())
  /// SHA-256 of the random token held in the browser cookie, so a leaked table can't be replayed.
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("erd_sessions")
}

/// One saved ERD (tables, columns, relations, canvas positions as JSON). A user can have several.
model Diagram {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("Untitled diagram")
  data      Json
  /// Shown in the "Pinned" part of the sidebar, above the recent diagrams.
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("erd_diagrams")
}

/// Fixed-window counters behind the rate limiter. Kept in Postgres (not memory) so limits hold across
/// serverless instances. Rows are tiny and swept opportunistically (see src/security/pgStore.ts).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("erd_rate_limits")
}

/// One-time numeric codes sent by email: confirming a new address at sign-up, and resetting a password. Only a salted
/// hash of the code is stored. A code lives 10 minutes and allows 5 guesses (see src/auth/codes.ts).
model EmailCode {
  id        String   @id @default(uuid())
  email     String
  /// "signup" | "reset"
  purpose   String
  salt      String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("erd_email_codes")
}
