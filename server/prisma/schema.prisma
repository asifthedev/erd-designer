// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the driver adapter (src/db.ts), not here.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model User {
  id           String   @id @default(uuid())
  /// Stored lower-cased and trimmed.
  email        String   @unique
  name         String?
  /// scrypt hash, never the password itself.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]
  diagram  Diagram?

  @@map("erd_users")
}

model Session {
  id String @id @default(uuid())
  /// SHA-256 of the random token held in the browser cookie, so a leaked table can't be replayed.
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("erd_sessions")
}

/// One saved workspace per user: the diagram model (tables, columns, relations, canvas positions) as JSON.
model Diagram {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("erd_diagrams")
}

/// Fixed-window counters behind the rate limiter. Kept in Postgres (not memory) so limits hold across
/// serverless instances. Rows are tiny and swept opportunistically (see src/security/pgStore.ts).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("erd_rate_limits")
}
