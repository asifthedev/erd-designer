// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and in the driver adapter (src/db.ts), not here.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

model User {
  id                   String    @id @default(uuid())
  /// Stored lower-cased and trimmed.
  email                String    @unique
  name                 String?
  /// scrypt hash, never the password itself.
  passwordHash         String    @map("password_hash")
  /// The person's look-and-feel settings (theme, table font, line style), kept here so they follow the account
  /// to every device. Validated on the way in (see preferencesSchema); null until they are first saved.
  preferences          Json?
  preferencesUpdatedAt DateTime? @map("preferences_updated_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  /// The plan the account is on (see Plan). A monthly plan stops at planExpiresAt and the account falls back to free.
  planId        String    @default("free") @map("plan_id")
  planExpiresAt DateTime? @map("plan_expires_at")

  plan     Plan      @relation(fields: [planId], references: [id])
  sessions Session[]
  diagrams Diagram[]
  orders   Order[]
  aiUsage  AiUsage[]

  @@map("erd_users")
}

model Session {
  id        String   @id @default(uuid())
  /// SHA-256 of the random token held in the browser cookie, so a leaked table can't be replayed.
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("erd_sessions")
}

/// One saved ERD (tables, columns, relations, canvas positions as JSON). A user can have several.
model Diagram {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String   @default("Untitled diagram")
  data      Json
  /// Shown in the "Pinned" part of the sidebar, above the recent diagrams.
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("erd_diagrams")
}

/// Fixed-window counters behind the rate limiter. Kept in Postgres (not memory) so limits hold across
/// serverless instances. Rows are tiny and swept opportunistically (see src/security/pgStore.ts).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("erd_rate_limits")
}

/// One-time numeric codes sent by email: confirming a new address at sign-up, and resetting a password. Only a salted
/// hash of the code is stored. A code lives 10 minutes and allows 5 guesses (see src/auth/codes.ts).
model EmailCode {
  id        String   @id @default(uuid())
  email     String
  /// "signup" | "reset"
  purpose   String
  salt      String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("erd_email_codes")
}

/// What an account may do. The three rows (free, monthly, lifetime) are created by a migration; the admin panel
/// edits their prices, limits, features and the lines shown on the pricing page. The ids are used by the code.
model Plan {
  id          String @id
  name        String
  /// How it is bought: free (nothing), monthly (renews by hand, ends at planExpiresAt), lifetime (once).
  kind        String
  description String @default("")
  /// In the smallest unit of `currency` (cents), so there is no floating point money.
  priceCents  Int    @default(0) @map("price_cents")
  currency    String @default("USD")

  maxDiagrams         Int      @map("max_diagrams")
  maxTablesPerDiagram Int      @map("max_tables_per_diagram")
  /// Paid features this plan includes: { export, codeFormats, themes, localCopy, setup } -> true / false.
  features            Json     @default("{}")
  /// The bullet lines shown for this plan on the pricing page.
  highlights          Json     @default("[]")
  active              Boolean  @default(true)
  sortOrder           Int      @default(0) @map("sort_order")
  updatedAt           DateTime @updatedAt @map("updated_at")

  users  User[]
  orders Order[]

  @@map("erd_plans")
}

/// A purchase request. Nothing is charged by the app: the buyer pays the way the payment instructions say, and the
/// admin marks the order paid, which activates the plan on the account.
model Order {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  planId      String    @map("plan_id")
  /// pending (waiting for payment), paid, or cancelled.
  status      String    @default("pending")
  /// The price at the time of ordering, so a later price change does not alter an open order.
  amountCents Int       @map("amount_cents")
  currency    String
  /// How to reach the buyer (phone / WhatsApp), mostly for setting up a lifetime copy.
  contact     String    @default("")
  /// The buyer's payment reference (transaction id, name on the transfer...) so the admin can match the payment.
  reference   String    @default("")
  adminNote   String    @default("") @map("admin_note")
  createdAt   DateTime  @default(now()) @map("created_at")
  paidAt      DateTime? @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("erd_orders")
}

/// Small admin-edited texts, e.g. the payment instructions shown at checkout.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("erd_settings")
}

/// Sessions of the admin panel. Admins are not users: they are set by environment variables, and these sessions are
/// separate from the website's (own cookie, own table, short life).
model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  email     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("erd_admin_sessions")
}

/// What the AI assistant used per account and (UTC) day: the daily request limit and the spend report.
/// A request is counted when it starts (so parallel requests cannot slip past the limit) and handed back when
/// the model failed before answering; tokens and cost are added when the answer finishes.
model AiUsage {
  userId       String   @map("user_id")
  day          DateTime @db.Date
  requests     Int      @default(0)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  /// Spend reported by the gateway, in millionths of a US dollar (0 when the gateway does not report cost).
  costMicros   BigInt   @default(0) @map("cost_micros")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
  @@map("erd_ai_usage")
}

/// The AI assistant's settings, edited in the admin panel (one row, id 1). Anything left empty falls back to the
/// server environment, then to a built-in default. API keys are stored encrypted (see src/ai/secrets.ts).
model AiSettings {
  id                Int      @id @default(1)
  /// Master switch: off, and nobody can use the assistant.
  enabled           Boolean  @default(true)
  gatewayBaseUrl    String?  @map("gateway_base_url")
  gatewayKeyEnc     String?  @map("gateway_key_enc")
  anthropicKeyEnc   String?  @map("anthropic_key_enc")
  /// [{ id, tier }]; null: the built-in list.
  models            Json?
  /// Offer every model the gateway lists that can call tools (instead of the list above).
  offerAllModels    Boolean  @default(false) @map("offer_all_models")
  defaultModel      String?  @map("default_model")
  dailyLimitFree    Int?     @map("daily_limit_free")
  dailyLimitPaid    Int?     @map("daily_limit_paid")
  maxDailySpendUsd  Float?   @map("max_daily_spend_usd")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("erd_ai_settings")
}
