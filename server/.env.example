# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection string (Prisma Postgres, Neon, local...). Use the pooled URL on serverless.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Port of the Express API (the Vite dev server proxies /api to it).
PORT=3001
# Email, for the codes that confirm a new address and reset a password. Any SMTP provider works (Gmail with an app
# password, Brevo, Mailgun, Amazon SES, ...). Without these, development prints each email (code included) to the
# server console, and production refuses to send codes, so nobody can sign up unverified.
# SMTP_URL="smtps://USERNAME:PASSWORD@smtp.example.com:465"
# MAIL_FROM="erd.designer <no-reply@example.com>"
# Production only (see server/README.md): NODE_ENV=production, ALLOWED_ORIGINS=, TRUST_PROXY=
# The admin panel login (/admin). Make the hash with `npm run admin:hash -w server` (it asks for the password, which is never
# stored). Put the hash in single quotes in a .env file, because it contains $ signs. Without both, /admin says "not set up".
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD_HASH='scrypt$32768$8$1$...'
